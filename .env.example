NODE_ENV=development
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=coopsave
DB_CONNECTION_LIMIT=10

# Railway usually provides one of these. If set, it can replace DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME.
DATABASE_URL=
MYSQL_URL=

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
TRUST_PROXY=1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=120
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=900000
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_PAYMENT_WINDOW_MS=600000
RATE_LIMIT_PAYMENT_MAX=10
RATE_LIMIT_PAYOUT_WINDOW_MS=900000
RATE_LIMIT_PAYOUT_MAX=5
RATE_LIMIT_BANK_VERIFY_WINDOW_MS=900000
RATE_LIMIT_BANK_VERIFY_MAX=10
# Optional shared limiter store for multi-instance deployments.
REDIS_URL=

NOMBA_BASE_URL=https://api.nomba.com/v1
NOMBA_ACCOUNT_ID=
NOMBA_CLIENT_ID=
NOMBA_CLIENT_SECRET=
NOMBA_WEBHOOK_SECRET=
NOMBA_TIMEOUT_MS=30000
NOMBA_AUTH_PATH=/auth/token/issue
NOMBA_VIRTUAL_ACCOUNTS_PATH=/virtual-accounts
NOMBA_TRANSACTIONS_PATH=/transactions
NOMBA_WEBHOOK_SIGNATURE_HEADER=nomba-signature
NOMBA_WEBHOOK_SIGNATURE_ALGORITHM=sha256

# Flutterwave Phase 1 test mode
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_MODE=test
FLUTTERWAVE_TIMEOUT_MS=30000
FLUTTERWAVE_VIRTUAL_ACCOUNT_PATH=/virtual-account-numbers
FLUTTERWAVE_VIRTUAL_ACCOUNT_PERMANENT=false
FLUTTERWAVE_VIRTUAL_ACCOUNT_AMOUNT=10000
FLUTTERWAVE_TRANSFERS_PATH=/transfers
FLUTTERWAVE_BANKS_PATH=/banks
FLUTTERWAVE_RESOLVE_ACCOUNT_PATH=/accounts/resolve
FLUTTERWAVE_TRANSFER_CALLBACK_URL=
FLUTTERWAVE_CHECKOUT_PATH=/payments
# Public backend callback URL. For local testing, use your active ngrok HTTPS URL.
FLUTTERWAVE_CHECKOUT_REDIRECT_URL=
# Frontend result page URL used after the backend verifies the provider result.
FLUTTERWAVE_CHECKOUT_RESULT_URL=
# Optional provider-configured methods, for example card,banktransfer,ussd.
FLUTTERWAVE_CHECKOUT_PAYMENT_OPTIONS=
PAYOUT_BANK_ENCRYPTION_KEY=
PAYOUT_ELIGIBLE_CYCLE_STATUSES=ACTIVE,COMPLETED
PAYOUT_COUNTRY=NG
PAYOUT_CURRENCY=NGN
